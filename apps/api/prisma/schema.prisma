generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Accounts aren't in v1, but every journal still has an owner. A seeded
// "local user" fills that role until auth lands, so adding real accounts
// later doesn't require reshaping existing data.
model User {
  id          String    @id @default(uuid()) @db.Uuid
  email       String    @unique
  displayName String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  journals    Journal[]
}

model Journal {
  id        String   @id @default(uuid()) @db.Uuid
  title     String
  ownerId   String   @db.Uuid
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}
