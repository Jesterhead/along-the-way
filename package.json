{
  "name": "along-the-way",
  "private": true,
  "type": "module",
  "description": "A shareable digital personal journal.",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "postinstall": "npm run generate",
    "generate": "npm run generate --workspaces",
    "dev": "npm run db:up && npm run db:migrate && npm run db:seed && concurrently -n api,web,codegen -c blue,magenta,gray \"npm run dev -w apps/api\" \"npm run dev -w apps/web\" \"npm run generate:watch -w apps/web\"",
    "build": "npm run build --workspaces",
    "test": "npm run db:up && npm run test --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate -w apps/api --",
    "db:migrate:new": "npm run db:migrate -w apps/api -- --create-only --name",
    "db:status": "npm run db:status -w apps/api",
    "db:studio": "npm run db:studio -w apps/api",
    "db:psql": "docker compose exec db psql -U along -d along_the_way",
    "db:seed": "npm run db:seed -w apps/api",
    "db:reset": "npm run db:reset -w apps/api"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
